{
  "agent_id": {
    "description": "角色 ID（修改会创建另一角色，不迁移旧状态）",
    "type": "string",
    "default": "persona-001"
  },
  "autonomous_enabled": {
    "description": "允许自主启动新活动",
    "type": "bool",
    "default": true
  },
  "disabled_activities": {
    "description": "禁用的活动定义 ID",
    "type": "list",
    "default": []
  },
  "qq_group_ids": {
    "description": "接收消息的 QQ 群 ID",
    "type": "list",
    "default": [],
    "hint": "先用管理员命令 /persona_scope 查看 group_id。空列表不记录群消息。"
  },
  "qq_private_ids": {
    "description": "接收消息的 QQ 私聊用户 ID",
    "type": "list",
    "default": [],
    "hint": "使用字符串 ID；空列表不记录私聊消息。"
  },
  "qq_platform_ids": {
    "description": "允许的 QQ 平台实例 ID",
    "type": "list",
    "default": [],
    "hint": "空列表允许受支持 QQ 适配器实例；可从 /persona_scope 复制 platform_id。"
  },
